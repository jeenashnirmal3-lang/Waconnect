# ==========================================
# Jeenash WA - Production Environment Variables
# ==========================================

NODE_ENV=production
PORT=3000

# Admin Dashboard Password (used for initial setup/login)
ADMIN_DASHBOARD_PASSWORD=@Jeenash123

# JWT Authentication Secrets (Must be 64-char random hex string in production)
# Generate via: openssl rand -hex 32
JWT_SECRET=c8f8b89e726b21908b9821ad5818ea19c368297bcf9509df6368d407d579ff9a
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=7f5b89a31cb8291f09756b1ad48301298c47e85c9a09148d88812cba560021fa
JWT_REFRESH_EXPIRES_IN=7d

# Database Connection (SQLite for quick local start, or PostgreSQL for high concurrency)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL:
# DATABASE_URL="postgresql://wa_admin:SecurePass123!@localhost:5432/jeenash_wa?schema=public"

# Allowed CORS Origins
CLIENT_URL=https://wa.jeenashera.online

# WhatsApp Sessions storage path (Ensure directory has chmod 700 permissions)
SESSION_PATH=./sessions

# Media Uploads Directory
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs

# Rate Limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
LOGIN_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000    # 1 minute
API_RATE_LIMIT_MAX=120
